From c42561a823fa01124246be3bcbcf327b1e958a3d Mon Sep 17 00:00:00 2001
From: Quentin Casasnovas <quentin.casasnovas@vates.tech>
Date: Thu, 19 Mar 2026 19:07:44 +0100
Subject: [PATCH] !kabi ipv6: prevent possible fib6 leaks

Fixes: 6bc3240adde5 ("ipv6: prevent possible fib6 leaks")
Signed-off-by: Quentin Casasnovas <quentin.casasnovas@vates.tech>
---
 include/net/ip6_fib.h | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/include/net/ip6_fib.h b/include/net/ip6_fib.h
index b4fea9dd589d..eac1f4946d63 100644
--- a/include/net/ip6_fib.h
+++ b/include/net/ip6_fib.h
@@ -171,8 +171,17 @@ struct fib6_info {
 					dst_nocount:1,
 					dst_nopolicy:1,
 					dst_host:1,
+#ifndef __GENKSYMS__
+	/*
+	 * c3240adde5 ("ipv6: prevent possible fib6 leaks") added the new
+	 * fib6_destroying bitfield, hide it from genksyms to avoid
+	 * unecessary kABI changes.
+	 */
 					fib6_destroying:1,
 					unused:2;
+#else
+					unused:3;
+#endif
 
 	struct fib6_nh			fib6_nh;
 	struct rcu_head			rcu;
-- 
2.43.0

