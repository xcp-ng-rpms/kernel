From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Vates Git Importer <gitimporter@vates.tech>
Date: Sat, 19 Sep 2015 07:09:42 +0100
Subject: [PATCH] Don't select PINCTRL

Selecting PINCTRL breaks the kABI due to the inclusion of a new member
in struct device. CONFIG_X86_AMD_PLATFORM_DEVICE is enabled to expose a clock
to the i2c-designware device and doesn't need explicit control of pins,
therefore ensure that it remains disabled.

Signed-off-by: Ross Lagerwall <ross.lagerwall@citrix.com>
---
 arch/x86/Kconfig | 1 -
 1 file changed, 1 deletion(-)

diff --git a/arch/x86/Kconfig b/arch/x86/Kconfig
index 9fd2e3c2494a..5b41c396ac91 100644
--- a/arch/x86/Kconfig
+++ b/arch/x86/Kconfig
@@ -621,7 +621,6 @@ config X86_AMD_PLATFORM_DEVICE
 	bool "AMD ACPI2Platform devices support"
 	depends on ACPI
 	select COMMON_CLK
-	select PINCTRL
 	---help---
 	  Select to interpret AMD specific ACPI device to platform device
 	  such as I2C, UART, GPIO found on AMD Carrizo and later chipsets.
