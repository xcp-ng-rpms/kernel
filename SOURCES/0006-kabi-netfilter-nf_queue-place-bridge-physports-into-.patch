From 59a151bbe35bf12998a740723f21452bab06d11c Mon Sep 17 00:00:00 2001
From: Quentin Casasnovas <quentin.casasnovas@vates.tech>
Date: Mon, 5 Oct 2026 11:22:28 +0200
Subject: [PATCH] !kabi netfilter: nf_queue: place bridge physports into
 queue_entry struct

Move the physin/physout fields out of struct nf_queue_entry and into the
nf_queue_entry_extra shadow variable to preserve the kabi.

Earlier commit in the branch created a shadow variable already for
nf_queue_entry, so we can simply extend it.

Fixes: 310b88563d01 ("netfilter: nf_queue: place bridge physports into queue_entry struct")
Signed-off-by: Quentin Casasnovas <quentin.casasnovas@vates.tech>
---
 include/net/netfilter/nf_queue.h |  6 ++++--
 net/netfilter/nf_queue.c         | 29 +++++++++++++++--------------
 2 files changed, 19 insertions(+), 16 deletions(-)

diff --git a/include/net/netfilter/nf_queue.h b/include/net/netfilter/nf_queue.h
index 35049f509ef4..d5d1555a2883 100644
--- a/include/net/netfilter/nf_queue.h
+++ b/include/net/netfilter/nf_queue.h
@@ -15,8 +15,6 @@ struct nf_queue_entry {
 	unsigned int		hook_index;	/* index in hook_entries->hook[] */
 #if IS_ENABLED(CONFIG_BRIDGE_NETFILTER)
 	struct net_device	*bridge_dev;
-	struct net_device	*physin;
-	struct net_device	*physout;
 #endif
 	struct nf_hook_state	state;
 	u16			size; /* sizeof(entry) + saved route keys */
@@ -34,6 +32,10 @@ struct nf_queue_entry {
 
 struct nf_queue_entry_extra {
 	struct net_device	*skb_dev;
+#if IS_ENABLED(CONFIG_BRIDGE_NETFILTER)
+	struct net_device	*physin;
+	struct net_device	*physout;
+#endif
 };
 
 static inline struct nf_queue_entry_extra *
diff --git a/net/netfilter/nf_queue.c b/net/netfilter/nf_queue.c
index 6d116e18fc30..54cfcd5e2bbe 100644
--- a/net/netfilter/nf_queue.c
+++ b/net/netfilter/nf_queue.c
@@ -72,15 +72,16 @@ void nf_queue_entry_release_refs(struct nf_queue_entry *entry)
 #if IS_ENABLED(CONFIG_BRIDGE_NETFILTER)
 	if (entry->bridge_dev)
 		dev_put(entry->bridge_dev);
-	if (entry->physin)
-		dev_put(entry->physin);
-	if (entry->physout)
-		dev_put(entry->physout);
+	if (extra && extra->physin)
+		dev_put(extra->physin);
+	if (extra && extra->physout)
+		dev_put(extra->physout);
 #endif
 }
 EXPORT_SYMBOL_GPL(nf_queue_entry_release_refs);
 
-static void __nf_queue_entry_init_physdevs(struct nf_queue_entry *entry)
+static void __nf_queue_entry_init_physdevs(struct nf_queue_entry *entry,
+					   struct nf_queue_entry_extra *extra)
 {
 #if IS_ENABLED(CONFIG_BRIDGE_NETFILTER)
 	const struct sk_buff *skb = entry->skb;
@@ -88,11 +89,11 @@ static void __nf_queue_entry_init_physdevs(struct nf_queue_entry *entry)
 	struct net_device *dev = NULL;
 
 	if (nf_bridge_info_exists(skb)) {
-		entry->physin = nf_bridge_get_physindev(skb);
-		entry->physout = nf_bridge_get_physoutdev(skb);
+		extra->physin = nf_bridge_get_physindev(skb);
+		extra->physout = nf_bridge_get_physoutdev(skb);
 	} else {
-		entry->physin = NULL;
-		entry->physout = NULL;
+		extra->physin = NULL;
+		extra->physout = NULL;
 	}
 
 	if (entry->state.pf == NFPROTO_BRIDGE &&
@@ -123,10 +124,10 @@ static void __nf_queue_entry_get_refs(struct nf_queue_entry *entry)
 #if IS_ENABLED(CONFIG_BRIDGE_NETFILTER)
 	if (entry->bridge_dev)
 		dev_hold(entry->bridge_dev);
-	if (entry->physin)
-		dev_hold(entry->physin);
-	if (entry->physout)
-		dev_hold(entry->physout);
+	if (extra && extra->physin)
+		dev_hold(extra->physin);
+	if (extra && extra->physout)
+		dev_hold(extra->physout);
 #endif
 }
 
@@ -256,7 +257,7 @@ static int __nf_queue(struct sk_buff *skb, const struct nf_hook_state *state,
 		.size	= sizeof(*entry) + route_key_size,
 	};
 
-	__nf_queue_entry_init_physdevs(entry);
+	__nf_queue_entry_init_physdevs(entry, extra);
 
 	if (!nf_queue_entry_get_refs_bool(entry)) {
 		status = -ENOTCONN;
