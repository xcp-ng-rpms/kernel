From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Vates Git Importer <gitimporter@vates.tech>
Date: Sat, 19 Sep 2015 07:09:42 +0100
Subject: [PATCH] If the host has more CPUs than the kernel is compiled for,
 warnings appear in the kernel log. This doesn't make sense for dom0 because
 the number of CPUs is set by Xen but it processes the host ACPI tables which
 lists all the CPUs. Hide the warning since it is expected.

Example warning:
[ 0.000000] ACPI: NR_CPUS/possible_cpus limit of 24 reached. Processor 27/0x3c ignored.
---
 arch/x86/kernel/apic/apic.c | 7 ++++---
 arch/x86/kernel/smpboot.c   | 5 +++--
 2 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/arch/x86/kernel/apic/apic.c b/arch/x86/kernel/apic/apic.c
index 20bc2f874db0..acb1dc7c0e4c 100644
--- a/arch/x86/kernel/apic/apic.c
+++ b/arch/x86/kernel/apic/apic.c
@@ -2444,9 +2444,10 @@ int generic_processor_info(int apicid, int version)
 	if (num_processors >= nr_cpu_ids) {
 		int thiscpu = max + disabled_cpus;
 
-		pr_warning("APIC: NR_CPUS/possible_cpus limit of %i "
-			   "reached. Processor %d/0x%x ignored.\n",
-			   max, thiscpu, apicid);
+		if (!xen_initial_domain())
+			pr_warning("APIC: NR_CPUS/possible_cpus limit of %i "
+				   "reached. Processor %d/0x%x ignored.\n",
+				   max, thiscpu, apicid);
 
 		disabled_cpus++;
 		return -EINVAL;
diff --git a/arch/x86/kernel/smpboot.c b/arch/x86/kernel/smpboot.c
index 2e4f6a1ebca5..0cdc0bf9ba32 100644
--- a/arch/x86/kernel/smpboot.c
+++ b/arch/x86/kernel/smpboot.c
@@ -1449,8 +1449,9 @@ __init void prefill_possible_map(void)
 
 	/* nr_cpu_ids could be reduced via nr_cpus= */
 	if (possible > nr_cpu_ids) {
-		pr_warn("%d Processors exceeds NR_CPUS limit of %u\n",
-			possible, nr_cpu_ids);
+		if (!xen_initial_domain())
+			pr_warn("%d Processors exceeds NR_CPUS limit of %u\n",
+				possible, nr_cpu_ids);
 		possible = nr_cpu_ids;
 	}
 
