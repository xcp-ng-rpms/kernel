From 874ff7e478593cc3f95afa5b15484f573a89dcdc Mon Sep 17 00:00:00 2001
From: Quentin Casasnovas <quentin.casasnovas@vates.tech>
Date: Thu, 24 Sep 2026 11:48:06 +0200
Subject: [PATCH] !kabi netfilter: nf_queue: hold bridge skb->dev while queued

Use the shadow variable API to add the extra field without changing the
kabi.  Annoingly, there are no single constructor for the nf_queue_entry
structure and its allocation/release is sprinkled in the code.

Fixes: 53396529f077 ("netfilter: nf_queue: hold bridge skb->dev while queued")
Signed-off-by: Quentin Casasnovas <quentin.casasnovas@vates.tech>
---
 include/net/netfilter/nf_queue.h | 21 ++++++++++++++++++++-
 net/netfilter/nf_queue.c         | 31 ++++++++++++++++++++++++-------
 net/netfilter/nfnetlink_queue.c  | 19 ++++++++++++++++++-
 3 files changed, 62 insertions(+), 9 deletions(-)

diff --git a/include/net/netfilter/nf_queue.h b/include/net/netfilter/nf_queue.h
index ef2f603670f4..b3d924a5e1ce 100644
--- a/include/net/netfilter/nf_queue.h
+++ b/include/net/netfilter/nf_queue.h
@@ -5,12 +5,12 @@
 #include <linux/ip.h>
 #include <linux/ipv6.h>
 #include <linux/jhash.h>
+#include <linux/shadow_var.h>
 
 /* Each queued (to userspace) skbuff has one of these. */
 struct nf_queue_entry {
 	struct list_head	list;
 	struct sk_buff		*skb;
-	struct net_device	*skb_dev;
 	unsigned int		id;
 	unsigned int		hook_index;	/* index in hook_entries->hook[] */
 
@@ -22,6 +22,25 @@ struct nf_queue_entry {
 
 #define nf_queue_entry_reroute(x) ((void *)x + sizeof(struct nf_queue_entry))
 
+/*
+ * Fields which can't be added to struct nf_queue_entry without breaking the
+ * kABI, attached to each entry as a shadow variable instead.
+ */
+#define NF_QUEUE_ENTRY_EXTRA "shadow_nf_queue_entry_extra"
+
+struct nf_queue_entry_extra {
+	struct net_device	*skb_dev;
+};
+
+static inline struct nf_queue_entry_extra *
+nf_queue_entry_extra(struct nf_queue_entry *entry)
+{
+	struct nf_queue_entry_extra *extra = shadow_var_get(entry, NF_QUEUE_ENTRY_EXTRA);
+
+	WARN_ON_ONCE(extra == NULL);
+	return extra;
+}
+
 /* Packet queuing */
 struct nf_queue_handler {
 	int		(*outfn)(struct nf_queue_entry *entry,
diff --git a/net/netfilter/nf_queue.c b/net/netfilter/nf_queue.c
index 3cb91270f308..6506591bcef6 100644
--- a/net/netfilter/nf_queue.c
+++ b/net/netfilter/nf_queue.c
@@ -3,6 +3,7 @@
  * Patrick McHardy (c) 2006-2012
  */
 
+#include <linux/shadow_var.h>
 #include <linux/kernel.h>
 #include <linux/slab.h>
 #include <linux/init.h>
@@ -49,10 +50,11 @@ EXPORT_SYMBOL(nf_unregister_queue_handler);
 void nf_queue_entry_release_refs(struct nf_queue_entry *entry)
 {
 	struct nf_hook_state *state = &entry->state;
+	struct nf_queue_entry_extra *extra = nf_queue_entry_extra(entry);
 
 	/* Release those devices we held, or Alexey will kill me. */
-	if (entry->skb_dev)
-		dev_put(entry->skb_dev);
+	if (extra && extra->skb_dev)
+		dev_put(extra->skb_dev);
 	if (state->in)
 		dev_put(state->in);
 	if (state->out)
@@ -78,9 +80,10 @@ EXPORT_SYMBOL_GPL(nf_queue_entry_release_refs);
 static void __nf_queue_entry_get_refs(struct nf_queue_entry *entry)
 {
 	struct nf_hook_state *state = &entry->state;
+	struct nf_queue_entry_extra *extra = nf_queue_entry_extra(entry);
 
-	if (entry->skb_dev)
-		dev_hold(entry->skb_dev);
+	if (extra && extra->skb_dev)
+		dev_hold(extra->skb_dev);
 	if (state->in)
 		dev_hold(state->in);
 	if (state->out)
@@ -175,6 +178,7 @@ static int __nf_queue(struct sk_buff *skb, const struct nf_hook_state *state,
 		      unsigned int index, unsigned int queuenum)
 {
 	int status = -ENOENT;
+	struct nf_queue_entry_extra *extra = NULL;
 	struct nf_queue_entry *entry = NULL;
 	const struct nf_queue_handler *qh;
 	struct net *net = state->net;
@@ -205,6 +209,15 @@ static int __nf_queue(struct sk_buff *skb, const struct nf_hook_state *state,
 		goto err;
 	}
 
+	extra = shadow_var_alloc(entry, NF_QUEUE_ENTRY_EXTRA, sizeof(*extra), GFP_ATOMIC);
+	if (extra == NULL) {
+		status = -ENOMEM;
+		goto err;
+	}
+	*extra = (struct nf_queue_entry_extra) {
+		.skb_dev = skb->dev,
+	};
+
 	if (skb_dst(skb) && !skb_dst_force(skb)) {
 		status = -ENETDOWN;
 		goto err;
@@ -212,15 +225,14 @@ static int __nf_queue(struct sk_buff *skb, const struct nf_hook_state *state,
 
 	*entry = (struct nf_queue_entry) {
 		.skb	= skb,
-		.skb_dev = skb->dev,
 		.state	= *state,
 		.hook_index = index,
 		.size	= sizeof(*entry) + route_key_size,
 	};
 
 	if (!nf_queue_entry_get_refs_bool(entry)) {
-		kfree(entry);
-		return -ENOTCONN;
+		status = -ENOTCONN;
+		goto err;
 	}
 
 	switch (entry->state.pf) {
@@ -242,7 +254,10 @@ static int __nf_queue(struct sk_buff *skb, const struct nf_hook_state *state,
 	return 0;
 
 err:
+	if (extra)
+		shadow_var_free(entry, NF_QUEUE_ENTRY_EXTRA);
 	kfree(entry);
+
 	return status;
 }
 
@@ -328,6 +343,7 @@ void nf_reinject(struct nf_queue_entry *entry, unsigned int verdict)
 	i = entry->hook_index;
 	if (WARN_ON_ONCE(!hooks || i >= hooks->num_hook_entries)) {
 		kfree_skb(skb);
+		shadow_var_free(entry, NF_QUEUE_ENTRY_EXTRA);
 		kfree(entry);
 		return;
 	}
@@ -367,6 +383,7 @@ void nf_reinject(struct nf_queue_entry *entry, unsigned int verdict)
 		kfree_skb(skb);
 	}
 
+	shadow_var_free(entry, NF_QUEUE_ENTRY_EXTRA);
 	kfree(entry);
 }
 EXPORT_SYMBOL(nf_reinject);
diff --git a/net/netfilter/nfnetlink_queue.c b/net/netfilter/nfnetlink_queue.c
index e922bfdd9fcf..29c70be4ad2f 100644
--- a/net/netfilter/nfnetlink_queue.c
+++ b/net/netfilter/nfnetlink_queue.c
@@ -17,6 +17,7 @@
 
 #define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
 
+#include <linux/shadow_var.h>
 #include <linux/module.h>
 #include <linux/skbuff.h>
 #include <linux/init.h>
@@ -715,13 +716,26 @@ static struct nf_queue_entry *
 nf_queue_entry_dup(struct nf_queue_entry *e)
 {
 	struct nf_queue_entry *entry = kmemdup(e, e->size, GFP_ATOMIC);
+	struct nf_queue_entry_extra *extra, *orig;
 
 	if (!entry)
 		return NULL;
 
+	extra = shadow_var_alloc(entry, NF_QUEUE_ENTRY_EXTRA, sizeof(*extra), GFP_ATOMIC);
+	if (!extra) {
+		kfree(entry);
+		return NULL;
+	}
+	orig = nf_queue_entry_extra(e);
+	if (orig)
+		*extra = *orig;
+	else
+		memset(extra, 0, sizeof(*extra));
+
 	if (nf_queue_entry_get_refs_bool(entry))
 		return entry;
 
+	shadow_var_free(entry, NF_QUEUE_ENTRY_EXTRA);
 	kfree(entry);
 	return NULL;
 }
@@ -750,6 +764,7 @@ static void nf_bridge_adjust_segmented_data(struct sk_buff *skb)
 static void free_entry(struct nf_queue_entry *entry)
 {
 	nf_queue_entry_release_refs(entry);
+	shadow_var_free(entry, NF_QUEUE_ENTRY_EXTRA);
 	kfree(entry);
 }
 
@@ -910,7 +925,9 @@ nfqnl_set_mode(struct nfqnl_instance *queue,
 static int
 dev_cmp(struct nf_queue_entry *entry, unsigned long ifindex)
 {
-	if (entry->skb_dev && entry->skb_dev->ifindex == ifindex)
+	struct nf_queue_entry_extra *extra = nf_queue_entry_extra(entry);
+
+	if (extra && extra->skb_dev && extra->skb_dev->ifindex == ifindex)
 		return 1;
 	if (entry->state.in)
 		if (entry->state.in->ifindex == ifindex)
