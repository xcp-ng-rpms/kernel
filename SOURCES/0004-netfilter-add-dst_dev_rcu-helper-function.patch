From 19c6b5a98fdf691302333a59680542595562a4b0 Mon Sep 17 00:00:00 2001
From: Quentin Casasnovas <quentin.casasnovas@vates.tech>
Date: Fri, 2 Oct 2026 06:49:01 +0200
Subject: [PATCH] netfilter: add dst_dev_rcu helper function.

This is coming directly from 1dbf1d590d10 ("net: Add locking to protect
skb->dev access in ip_output"), because it is used by earlier commit in the
branch be99fe17aced ("netfilter: add dst_dev_rcu helper function.").

Backporting the whole commit is more trouble just to get that function as
it doesn't apply cleanly.

Signed-off-by: Quentin Casasnovas <quentin.casasnovas@vates.tech>
---
 net/netfilter/nf_queue.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/net/netfilter/nf_queue.c b/net/netfilter/nf_queue.c
index 6884d5538fc4..cb7d7e525ef5 100644
--- a/net/netfilter/nf_queue.c
+++ b/net/netfilter/nf_queue.c
@@ -22,6 +22,13 @@
 
 #include "nf_internals.h"
 
+static inline struct net_device *dst_dev_rcu(const struct dst_entry *dst)
+{
+	/* In the future, use rcu_dereference(dst->dev) */
+	WARN_ON_ONCE(!rcu_read_lock_held());
+	return READ_ONCE(dst->dev);
+}
+
 /*
  * Hook for nfnetlink_queue to register its queue handler.
  * We do this so that most of the NFQUEUE code can be modular.
