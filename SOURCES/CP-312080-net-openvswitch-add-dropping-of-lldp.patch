diff --git a/net/openvswitch/vport-netdev.c b/net/openvswitch/vport-netdev.c
index 903537a5d..6b9bcdb59 100644
--- a/net/openvswitch/vport-netdev.c
+++ b/net/openvswitch/vport-netdev.c
@@ -23,6 +23,11 @@
 #include "vport-internal_dev.h"
 #include "vport-netdev.h"
 
+static int ignore_lldp = 1;
+module_param(ignore_lldp, int, 0644);
+MODULE_PARM_DESC(ignore_lldp, "Ignores LLDP packets from being processed by openvswitch. 0-Disable, 1-Enable (default)");
+ 
+
 static struct vport_ops ovs_netdev_vport_ops;
 
 /* Must be called with rcu_read_lock. */
@@ -61,6 +66,14 @@ static rx_handler_result_t netdev_frame_hook(struct sk_buff **pskb)
 	if (unlikely(skb->pkt_type == PACKET_LOOPBACK))
 		return RX_HANDLER_PASS;
 
+	/* This is hack to make ovs not process
+	 * LLDP packets, which is required for FCoE.
+ 	 * ETH_P_LLDP (0x88cc) is not defined in kernel
+ 	 */
+	if ((ignore_lldp) &&
+		(skb->protocol == cpu_to_be16(0x88CC)))
+ 		return RX_HANDLER_PASS;
+
 	netdev_port_receive(skb);
 	return RX_HANDLER_CONSUMED;
 }
