%regenerate_initrd_post() \
> %{_localstatedir}/lib/rpm-state/regenerate-initrd-%{kernel_version} \
%{nil}

%regenerate_initrd_postun() \
if [ $1 -eq 0 ]; then \
    dracut -f /boot/initrd-%{kernel_version}.img %{kernel_version} \
else \
    > %{_localstatedir}/lib/rpm-state/regenerate-initrd-%{kernel_version} \
fi \
%{nil}

%regenerate_initrd_posttrans() \
if [ -e %{_localstatedir}/lib/rpm-state/regenerate-initrd-%{kernel_version} ]; then \
    rm %{_localstatedir}/lib/rpm-state/regenerate-initrd-%{kernel_version} \
    dracut -f /boot/initrd-%{kernel_version}.img %{kernel_version} \
    udevadm trigger --attr-nomatch=driver && udevadm settle -t 30 \
fi \
%{nil}


## %1 is the .ko file into which we embed the note.bin generated by gen-note
%generate_dmv_info() \
dmv-info %{driver_name} -t %{type} -d "%{driver_desc}" -v %{version} -m %{xsrel} -s %{status} -p %{priority} -a %{variant} -k %{kernel_version} \
gen-note -r XenServer -v %{variant} -m %{version} -o %{xsrel} \
objcopy --add-section .note.XenServer=note.bin %1 --set-section-flags .note.XenServer=alloc,readonly %1.temp \
rm %1 \
mv %1.temp %1 \
%{nil}

%install_dmv_info() \
mv %{_builddir}/%{source_name}-%{version}/info.json %{buildroot}/lib/modules/%{kernel_version}/%{dmv_dir} \
%{nil}

%modsign_install_post() \
%{expand:%global __modsign_install_post \\
  sign_file=%(find /usr/src/ -name sign-file | tail -1) \\
  find %{buildroot} -name "*.ko" -type f -exec sh -c " \\
    %{get_module_signature -c %1 -i {} -o {}.sig} \\
    ${sign_file} -s {}.sig sha256 unused {} \\
    rm -f {}.sig" \\\\; } \
\
%{expand:%global __spec_install_post \\
  %{?__debug_package:%{__debug_install_post}} \\
  %{__arch_install_post} \\
  %{__os_install_post} \\
  %{__modsign_install_post}} \
%{nil}
