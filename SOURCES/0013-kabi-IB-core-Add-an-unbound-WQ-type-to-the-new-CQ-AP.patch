From a04cecb13196f22ce9cb7c0e87067128cd80770a Mon Sep 17 00:00:00 2001
From: Quentin Casasnovas <quentin.casasnovas@vates.tech>
Date: Mon, 16 Mar 2026 12:02:33 +0100
Subject: [PATCH] !kabi IB/core: Add an unbound WQ type to the new CQ API

Just hide the new enum value from genksyms.

Fixes: 2661d462aaa9 ("IB/core: Add an unbound WQ type to the new CQ API")
Signed-off-by: Quentin Casasnovas <quentin.casasnovas@vates.tech>
---
 include/rdma/ib_verbs.h | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/include/rdma/ib_verbs.h b/include/rdma/ib_verbs.h
index 874cd6e94093..19a128bf4602 100644
--- a/include/rdma/ib_verbs.h
+++ b/include/rdma/ib_verbs.h
@@ -1580,7 +1580,15 @@ enum ib_poll_context {
 	IB_POLL_DIRECT,		   /* caller context, no hw completions */
 	IB_POLL_SOFTIRQ,	   /* poll from softirq context */
 	IB_POLL_WORKQUEUE,	   /* poll from workqueue */
+#ifndef __GENKSYMS__
+	/**
+	 * 2661d462aaa9 ("IB/core: Add an unbound WQ type to the new CQ
+	 * API") adds a new enum value, which causes some exported symbols
+	 * to have a kABI change.  It is safe for prior users of the enum
+	 * to be constrained to the old values.
+	 */
 	IB_POLL_UNBOUND_WORKQUEUE, /* poll from unbound workqueue */
+#endif
 };
 
 struct ib_cq {
-- 
2.43.0

