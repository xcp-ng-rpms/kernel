From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tu Dinh <ngoc-tu.dinh@vates.tech>
Date: Wed, 2 Sep 2026 20:56:47 +0200
Subject: [PATCH] blktap2: Do not lock mmap_sem in blktap_ring_ioctl

blktap_ring_ioctl may fault in copy_from_user. So instead of grabbing
mmap_sem in blktap_ring_ioctl, grab it only after we have obtained the
parameter block.

Lockdep warning:

    ============================================
    WARNING: possible recursive locking detected
    4.19.0+1 #1 Not tainted
    --------------------------------------------
    tapdisk/3013 is trying to acquire lock:
    00000000dc4996c2 (&mm->mmap_sem){++++}, at: __might_fault+0x3e/0x90

    but task is already holding lock:
    00000000dc4996c2 (&mm->mmap_sem){++++}, at: blktap_ring_ioctl+0x2f/0x60

    other info that might help us debug this:
    Possible unsafe locking scenario:

    CPU0
    ----
    lock(&mm->mmap_sem);
    lock(&mm->mmap_sem);

    *** DEADLOCK ***

    May be due to missing lock nesting notation

    1 lock held by tapdisk/3013:
    #0: 00000000dc4996c2 (&mm->mmap_sem){++++}, at: blktap_ring_ioctl+0x2f/0x60

    stack backtrace:
    CPU: 4 PID: 3013 Comm: tapdisk Not tainted 4.19.0+1 #1
    Call Trace:
    dump_stack+0x78/0xb3
    __lock_acquire+0x16f9/0x1720
    ? try_to_wake_up+0x54/0x5c0
    ? find_held_lock+0x31/0xa0
    ? ep_poll_callback+0x133/0x450
    ? lock_release+0x141/0x2b0
    lock_acquire+0xbd/0x1c0
    ? __might_fault+0x3e/0x90
    __might_fault+0x6b/0x90
    ? __might_fault+0x3e/0x90
    _copy_from_user+0x1e/0x90
    __blktap_ring_ioctl.isra.3+0xbd/0x340
    ? __lock_acquire+0x2f2/0x1720
    ? lock_release+0x141/0x2b0
    ? __lock_acquire+0x2f2/0x1720
    ? lock_acquire+0xd8/0x1c0
    ? blktap_ring_ioctl+0x2f/0x60
    blktap_ring_ioctl+0x40/0x60
    do_vfs_ioctl+0xa9/0x720
    ? __fget+0x10f/0x200
    ? __fget+0x5/0x200
    ksys_ioctl+0x60/0x90
    __x64_sys_ioctl+0x16/0x20
    do_syscall_64+0x56/0x1a0
    entry_SYSCALL_64_after_hwframe+0x49/0xbe
    RIP: 0033:0x7ff9f943e5d7
    Code: 44 00 00 48 8b 05 b9 08 2d 00 64 c7 00 26 00 00 00 48 c7 c0 ff
          ff ff ff c3 66 2e 0f 1f 84 00 00 00 00 00 b8 10 00 00 00 0f 05
          <48> 3d 01 f0 ff ff 73 01 c3 48 8b 0d 89 08 2d 00 f7 d8 64 89
          01 48
    RSP: 002b:00007ffe6f0d0558 EFLAGS: 00000202 ORIG_RAX: 0000000000000010
    RAX: ffffffffffffffda RBX: 00007ffe6f0d0620 RCX: 00007ff9f943e5d7
    RDX: 00007ffe6f0d0560 RSI: 00000000000000d0 RDI: 0000000000000010
    RBP: 000000000065df20 R08: 0000000000000000 R09: 0000000000000000
    R10: 00007ffe6f0cffe0 R11: 0000000000000202 R12: 00007ffe6f0d0560
    R13: 0000000000445670 R14: 0000000000445450 R15: 000000000065ddd8

Signed-off-by: Tu Dinh <ngoc-tu.dinh@vates.tech>

diff --git a/drivers/block/blktap2/ring.c b/drivers/block/blktap2/ring.c
index 01500b6d915c..1ed5c8cfd7ef 100644
--- a/drivers/block/blktap2/ring.c
+++ b/drivers/block/blktap2/ring.c
@@ -386,14 +386,17 @@ __blktap_ring_ioctl(struct file *filp, unsigned int cmd, unsigned long arg)
 
 	BTDBG("%d: cmd: %u, arg: %lu\n", tap->minor, cmd, arg);
 
-	if (!blktap_ring_vma_valid(ring))
-		return -EACCES;
-
 	switch(cmd) {
 	case BLKTAP_IOCTL_RESPOND:
 
-		blktap_read_ring(tap);
-		return 0;
+		err = -EACCES;
+		down_read(&current->mm->mmap_sem);
+		if (blktap_ring_vma_valid(ring)) {
+			blktap_read_ring(tap);
+			err = 0;
+		}
+		up_read(&current->mm->mmap_sem);
+		return err;
 
 	case BLKTAP_IOCTL_CREATE_DEVICE_COMPAT: {
 		struct blktap_device_info info;
@@ -407,7 +410,11 @@ __blktap_ring_ioctl(struct file *filp, unsigned int cmd, unsigned long arg)
 		info.physical_sector_size = params.sector_size;
 		info.flags                = 0;
 
-		err = blktap_device_create(tap, &info);
+		err = -EACCES;
+		down_read(&current->mm->mmap_sem);
+		if (blktap_ring_vma_valid(ring))
+			err = blktap_device_create(tap, &info);
+		up_read(&current->mm->mmap_sem);
 		if (err)
 			return err;
 
@@ -423,12 +430,22 @@ __blktap_ring_ioctl(struct file *filp, unsigned int cmd, unsigned long arg)
 		if (copy_from_user(&info, ptr, sizeof(info)))
 			return -EFAULT;
 
-		return blktap_device_create(tap, &info);
+		err = -EACCES;
+		down_read(&current->mm->mmap_sem);
+		if (blktap_ring_vma_valid(ring))
+			err = blktap_device_create(tap, &info);
+		up_read(&current->mm->mmap_sem);
+		return err;
 	}
 
 	case BLKTAP_IOCTL_REMOVE_DEVICE:
 
-		return blktap_device_destroy(tap);
+		err = -EACCES;
+		down_read(&current->mm->mmap_sem);
+		if (blktap_ring_vma_valid(ring))
+			err = blktap_device_destroy(tap);
+		up_read(&current->mm->mmap_sem);
+		return err;
 	}
 
 	return -ENOIOCTLCMD;
@@ -439,9 +456,7 @@ blktap_ring_ioctl(struct file *filp, unsigned int cmd, unsigned long arg)
 {
 	int ret;
 
-	down_read(&current->mm->mmap_sem);
 	ret = __blktap_ring_ioctl(filp, cmd, arg);
-	up_read(&current->mm->mmap_sem);
 
 	return ret;
 }
