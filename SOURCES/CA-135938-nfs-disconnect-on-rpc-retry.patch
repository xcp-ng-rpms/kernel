From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Vates Git Importer <gitimporter@vates.tech>
Date: Sat, 19 Sep 2015 07:09:42 +0100
Subject: [PATCH] CA-135938-nfs-disconnect-on-rpc-retry

---
 fs/nfs/client.c       | 1 +
 net/sunrpc/clnt.c     | 4 ++++
 net/sunrpc/xprtsock.c | 2 ++
 3 files changed, 7 insertions(+)

diff --git a/fs/nfs/client.c b/fs/nfs/client.c
index 6a44a7f894f7..4a8772f1db66 100644
--- a/fs/nfs/client.c
+++ b/fs/nfs/client.c
@@ -719,6 +719,7 @@ static int nfs_init_server(struct nfs_server *server,
 			data->timeo, data->retrans);
 	if (data->flags & NFS_MOUNT_NORESVPORT)
 		set_bit(NFS_CS_NORESVPORT, &cl_init.init_flags);
+	set_bit(NFS_CS_DISCRTRY, &cl_init.init_flags);
 
 	/* Allocate or find a client reference we can use */
 	clp = nfs_get_client(&cl_init);
diff --git a/net/sunrpc/clnt.c b/net/sunrpc/clnt.c
index 3bdaebe5e53d..2acda9c84e42 100644
--- a/net/sunrpc/clnt.c
+++ b/net/sunrpc/clnt.c
@@ -2160,6 +2160,10 @@ call_status(struct rpc_task *task)
 		/* fall through */
 	case -ETIMEDOUT:
 		task->tk_action = call_timeout;
+		if (!(task->tk_flags & RPC_TASK_NO_RETRANS_TIMEOUT)
+		    && task->tk_client->cl_discrtry)
+			xprt_conditional_disconnect(req->rq_xprt,
+					req->rq_connect_cookie);
 		break;
 	case -ECONNREFUSED:
 	case -ECONNRESET:
diff --git a/net/sunrpc/xprtsock.c b/net/sunrpc/xprtsock.c
index e2336842fb97..4dcc93dd137d 100644
--- a/net/sunrpc/xprtsock.c
+++ b/net/sunrpc/xprtsock.c
@@ -2290,6 +2290,8 @@ static void xs_tcp_shutdown(struct rpc_xprt *xprt)
 		break;
 	case TCP_CLOSE:
 	case TCP_TIME_WAIT:
+	case TCP_FIN_WAIT1:
+	case TCP_FIN_WAIT2:
 		xs_reset_transport(transport);
 	}
 }
