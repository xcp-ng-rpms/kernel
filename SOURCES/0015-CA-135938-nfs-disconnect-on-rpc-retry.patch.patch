From 58bf2eeef7ac9da246b859718446d4c5ad101c95 Mon Sep 17 00:00:00 2001
From: Corentin Oparowski <corentin.oparowski@vates.tech>
Date: Sat, 19 Sep 2015 08:09:42 +0200
Subject: [PATCH 15/36] CA-135938-nfs-disconnect-on-rpc-retry.patch

---
 fs/nfs/client.c       | 1 +
 net/sunrpc/clnt.c     | 4 ++++
 net/sunrpc/xprtsock.c | 2 --
 3 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/fs/nfs/client.c b/fs/nfs/client.c
index 8bdde6cc873f1..89bd800765dc9 100644
--- a/fs/nfs/client.c
+++ b/fs/nfs/client.c
@@ -742,6 +742,7 @@ static int nfs_init_server(struct nfs_server *server,
 				ctx->timeo, ctx->retrans);
 	if (ctx->flags & NFS_MOUNT_NORESVPORT)
 		set_bit(NFS_CS_NORESVPORT, &cl_init.init_flags);
+	set_bit(NFS_CS_DISCRTRY, &cl_init.init_flags);
 
 	/* Allocate or find a client reference we can use */
 	clp = nfs_get_client(&cl_init);
diff --git a/net/sunrpc/clnt.c b/net/sunrpc/clnt.c
index 4541d4ca84674..dd3b1e4a3f884 100644
--- a/net/sunrpc/clnt.c
+++ b/net/sunrpc/clnt.c
@@ -2473,6 +2473,10 @@ call_status(struct rpc_task *task)
 		rpc_delay(task, 3*HZ);
 		fallthrough;
 	case -ETIMEDOUT:
+		if (!(task->tk_flags & RPC_TASK_NO_RETRANS_TIMEOUT)
+		    && task->tk_client->cl_discrtry)
+			xprt_conditional_disconnect(task->tk_rqstp->rq_xprt,
+					task->tk_rqstp->rq_connect_cookie);
 		break;
 	case -ECONNREFUSED:
 	case -ECONNRESET:
diff --git a/net/sunrpc/xprtsock.c b/net/sunrpc/xprtsock.c
index 56819b6a7bde2..74a5bc2a9c946 100644
--- a/net/sunrpc/xprtsock.c
+++ b/net/sunrpc/xprtsock.c
@@ -2262,8 +2262,6 @@ static void xs_tcp_shutdown(struct rpc_xprt *xprt)
 		return;
 	}
 	switch (skst) {
-	case TCP_FIN_WAIT1:
-	case TCP_FIN_WAIT2:
 	case TCP_LAST_ACK:
 		break;
 	case TCP_ESTABLISHED:
-- 
2.47.3

