+9f7013265112a (Anup Patel    2021-09-27 17:10:06 +0530 139) 
+9f7013265112a (Anup Patel    2021-09-27 17:10:06 +0530 140) 	/* Change Guest SSTATUS.SPP bit */
+9f7013265112a (Anup Patel    2021-09-27 17:10:06 +0530 141) 	vsstatus &= ~SR_SPP;
+9f7013265112a (Anup Patel    2021-09-27 17:10:06 +0530 142) 	if (vcpu->arch.guest_context.sstatus & SR_SPP)
