+9f7013265112a (Anup Patel    2021-09-27 17:10:06 +0530 144) 
+9f7013265112a (Anup Patel    2021-09-27 17:10:06 +0530 145) 	/* Change Guest SSTATUS.SPIE bit */
+9f7013265112a (Anup Patel    2021-09-27 17:10:06 +0530 146) 	vsstatus &= ~SR_SPIE;
+9f7013265112a (Anup Patel    2021-09-27 17:10:06 +0530 147) 	if (vsstatus & SR_SIE)
+9f7013265112a (Anup Patel    2021-09-27 17:10:06 +0530 148) 		vsstatus |= SR_SPIE;
+9f7013265112a (Anup Patel    2021-09-27 17:10:06 +0530 149) 
+9f7013265112a (Anup Patel    2021-09-27 17:10:06 +0530 150) 	/* Clear Guest SSTATUS.SIE bit */
+9f7013265112a (Anup Patel    2021-09-27 17:10:06 +0530 151) 	vsstatus &= ~SR_SIE;
+9f7013265112a (Anup Patel    2021-09-27 17:10:06 +0530 152) 
+9f7013265112a (Anup Patel    2021-09-27 17:10:06 +0530 153) 	/* Update Guest SSTATUS */
